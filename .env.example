# Copy to .env and fill in. Never commit .env.

# Optional. Anonymous access works but is rate-limited more aggressively.
# Create a read-only key at https://www.peeringdb.com/ (Profile -> API Keys).
PEERINGDB_API_KEY=

# Contact address sent to Nominatim (their usage policy asks for one).
NOMINATIM_EMAIL=

# Staging database (the compose file provides an isolated PostGIS).
POSTGRES_DB=iris
POSTGRES_USER=iris_staging_writer
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://iris_staging_writer:change-me-locally@postgis:5432/iris
